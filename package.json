{
  "name": "pw-hybrid-e2e-framework",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "Hybrid Playwright + TypeScript E2E framework against Automation Exercise: real public REST API for test-data setup/cleanup + POM UI layer.",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:ui": "playwright test --project=chromium tests/ui",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "zod": "^3.25.0"
  }
}
